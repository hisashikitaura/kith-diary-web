rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedUser() {
      return request.auth != null
        && request.auth.token.email == '__OWNER_EMAIL__';
    }

    // Web (and nested path)
    match /users/{uid} {
      allow read, write: if isAllowedUser() && request.auth.uid == uid;

      match /entries/{entryId} {
        allow read, write: if isAllowedUser() && request.auth.uid == uid;
      }

      // Kith Food meals (iOS). Owner only; AI fields are written by Cloud Functions (admin SDK).
      match /meals/{mealId} {
        allow read, delete: if isAllowedUser() && request.auth.uid == uid;
        allow create, update: if isAllowedUser() && request.auth.uid == uid
          && request.resource.data.photoPath == 'users/' + uid + '/meals/' + mealId + '.jpg';
      }

      // AI analyses: written only by Cloud Functions (admin SDK)
      match /analyses/{month} {
        allow read: if isAllowedUser() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Legacy top-level entries (older iOS). Delete must NOT require request.resource.
    match /entries/{entryId} {
      allow read: if isAllowedUser()
        && resource.data.userId == request.auth.uid;
      allow create: if isAllowedUser()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAllowedUser()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAllowedUser()
        && resource.data.userId == request.auth.uid;
    }

    match /securityLogs/{logId} {
      allow read: if isAllowedUser()
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /auditLogs/{logId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['result', 'method', 'at'])
        && request.resource.data.result in ['success', 'failure']
        && request.resource.data.method is string
        && request.resource.data.at is number;
      allow read: if isAllowedUser();
      allow update, delete: if false;
    }

    // ===== Miso site (hisashikitaura/miso-site) =====
    // Public: published entries + settings are readable by anyone. Owner-only writes.
    function isMisoOwner() {
      return isAllowedUser() && request.auth.token.email_verified == true;
    }
    function validMisoEntry(d) {
      return d.keys().hasOnly(['stage', 'date', 'title', 'body', 'photos', 'published', 'createdAt', 'updatedAt'])
        && d.stage in ['shikomi', 'jukusei', 'kansei']
        && d.date is string && d.date.size() == 10
        && d.title is string && d.title.size() <= 200
        && d.body is string && d.body.size() <= 20000
        && d.photos is list && d.photos.size() <= 12
        && d.published is bool;
    }
    match /miso_entries/{entryId} {
      allow get, list: if resource.data.published == true || isMisoOwner();
      allow create, update: if isMisoOwner() && validMisoEntry(request.resource.data);
      allow delete: if isMisoOwner();
    }
    match /miso_settings/{docId} {
      // "owner" doc is a private probe the admin UI reads to confirm owner access.
      allow read: if docId != 'owner' || isMisoOwner();
      allow write: if isMisoOwner();
    }
  }
}
