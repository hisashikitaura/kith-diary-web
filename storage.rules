rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAllowedUser() {
      return request.auth != null
        && request.auth.token.email == 'owner@example.com';
    }

    // Web path
    match /users/{uid}/{allPaths=**} {
      allow read: if isAllowedUser() && request.auth.uid == uid;
    }

    // Web diary photos
    match /users/{uid}/entries/{allPaths=**} {
      allow write: if isAllowedUser() && request.auth.uid == uid;
    }

    // Kith Food meal photos: owner only, JPEG/image, < 10MB
    match /users/{uid}/meals/{file} {
      allow delete: if isAllowedUser() && request.auth.uid == uid;
      allow create, update: if isAllowedUser() && request.auth.uid == uid
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024;
    }

    // iOS path: images/{userId}/...
    match /images/{uid}/{allPaths=**} {
      allow read, write: if isAllowedUser() && request.auth.uid == uid;
    }
  }
}
